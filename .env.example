# 站点名称（登录提示、浏览器标题都用它）
SITE_NAME=Codenova 实验室

# 整站 HTTP Basic 登录保护；两个人以上共用时建议保持开启
APP_AUTH_ENABLED=1
APP_USERNAME=codenova
APP_PASSWORD=replace-with-a-long-random-password

# 多用户模式：1 表示每个浏览器各自一份进度、脚本目录和 sandbox（适合多人共用或上课用）
MULTI_USER=0

# 每人 10 秒内允许执行的命令条数
TERMINAL_RATE_LIMIT=60

# 进度数据库路径（默认 data/progress.sqlite3）
# PROGRESS_DB=data/progress.sqlite3
